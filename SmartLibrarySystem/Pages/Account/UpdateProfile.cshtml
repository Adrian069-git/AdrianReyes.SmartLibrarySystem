@page "/account/update-profile"
@model UpdateProfileModel
@{ ViewData["Title"] = "Update Profile"; }
<div class="container py-5" style="max-width:700px">
<div class="card shadow-sm"><div class="card-body p-5">
<h2 class="mb-4">Update Profile</h2>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="text-center mb-4"><img src="@Model.ProfileImage" alt="Profile image" class="rounded-circle" style="width:140px;height:140px;object-fit:cover;" /></div>
<div class="mb-3"><label class="form-label">Username</label><span class="form-control bg-light">@Model.Username</span></div>
<form method="post">
<div class="mb-3"><label asp-for="Input.FirstName" class="form-label">First Name</label><input asp-for="Input.FirstName" class="form-control" /><span asp-validation-for="Input.FirstName" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.LastName" class="form-label">Last Name</label><input asp-for="Input.LastName" class="form-control" /><span asp-validation-for="Input.LastName" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.DateOfBirth" class="form-label">Date of Birth</label><input asp-for="Input.DateOfBirth" type="date" class="form-control" /><span asp-validation-for="Input.DateOfBirth" class="text-danger"></span></div>
<button class="btn btn-primary" type="submit">Save Changes</button> <a asp-page="/Account/MyProfile" class="btn btn-secondary">Cancel</a>
</form></div></div></div>
