@page "/account/login"
@model Login

<div class="login-page">

    <!-- LEFT BRAND PANEL -->
    <div class="login-brand-panel">

        <div class="brand-container">

            <div class="brand-logo">
                SL
            </div>

            <div class="brand-name">
                <strong>Smart Library</strong>
                <span>Management System</span>
            </div>

        </div>


        <div class="brand-content">

            <div class="small-label">
                SMART LIBRARY MANAGEMENT SYSTEM
            </div>

            <h1>
                Your library,<br />
                <span>smarter.</span>
            </h1>

            <p>
                A modern and secure library management system designed
                to organize library resources, users, and activities
                in one convenient platform.
            </p>


            <div class="feature-list">

                <div class="feature-item">
                    <div class="feature-icon">📚</div>

                    <div>
                        <strong>Library Management</strong>
                        <span>Organize your library resources.</span>
                    </div>
                </div>


                <div class="feature-item">
                    <div class="feature-icon">👥</div>

                    <div>
                        <strong>User Management</strong>
                        <span>Manage authorized library users.</span>
                    </div>
                </div>


                <div class="feature-item">
                    <div class="feature-icon">🔐</div>

                    <div>
                        <strong>Secure Access</strong>
                        <span>Protected authentication and accounts.</span>
                    </div>
                </div>

            </div>

        </div>


        <div class="brand-footer">
            <span>Organize.</span>
            <span>Manage.</span>
            <span>Discover.</span>
        </div>

    </div>


    <!-- RIGHT LOGIN PANEL -->
    <div class="login-panel">

        <div class="login-box">

            <!-- MOBILE LOGO -->
            <div class="mobile-brand">

                <div class="mobile-logo">
                    SL
                </div>

                <div>
                    <strong>Smart Library</strong>
                    <span>Management System</span>
                </div>

            </div>


            <!-- LOGIN HEADER -->
            <div class="login-header">

                <span class="login-label">
                    ACCOUNT ACCESS
                </span>

                <h2>
                    Welcome back
                </h2>

                <p>
                    Sign in to access your Smart Library account.
                </p>

            </div>


            <!-- LOGIN FORM -->
            <form method="post" class="login-form">

                <!-- ERROR MESSAGE -->
                @if (ViewData.ModelState[string.Empty]?.Errors.Any() == true)
                {
                    <div class="login-error">

                        <span class="message-icon">!</span>

                        <div>
                            @ViewData.ModelState[string.Empty]!.Errors.First().ErrorMessage
                        </div>

                    </div>
                }


                <!-- SUCCESS MESSAGE -->
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="login-success">

                        <span class="message-icon">✓</span>

                        <div>
                            @Model.SuccessMessage
                        </div>

                    </div>
                }


                <!-- USERNAME / EMAIL -->
                <div class="input-group-custom">

                    <label asp-for="UserLoginDto.UserName">
                        Email
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            ✉
                        </span>

                        <input asp-for="UserLoginDto.UserName"
                               type="email"
                               class="custom-input"
                               placeholder="Enter your email"
                               autocomplete="username" />

                    </div>

                    <span asp-validation-for="UserLoginDto.UserName"
                          class="validation-message">
                    </span>

                </div>


                <!-- PASSWORD -->
                <div class="input-group-custom">

                    <div class="password-label-row">

                        <label asp-for="UserLoginDto.Password">
                            Password
                        </label>

                        <a asp-page="/Account/ForgotPassword">
                            Forgot password?
                        </a>

                    </div>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            🔒
                        </span>

                        <input asp-for="UserLoginDto.Password"
                               type="password"
                               class="custom-input password-input"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <button type="button"
                                class="show-password"
                                onclick="togglePassword()"
                                aria-label="Show password">
                            👁
                        </button>

                    </div>

                    <span asp-validation-for="UserLoginDto.Password"
                          class="validation-message">
                    </span>

                </div>


                <!-- LOGIN BUTTON -->
                <button type="submit" class="login-button">

                    <span>
                        Sign In
                    </span>

                    <span class="button-arrow">
                        →
                    </span>

                </button>


                <!-- SECURITY NOTE -->
                <div class="security-note">

                    <span>🔐</span>

                    <p>
                        Your account is protected by secure authentication.
                    </p>

                </div>

            </form>


            <!-- FOOTER -->
            <div class="login-footer">

                <span>
                    Smart Library Management System
                </span>

                <span>
                    © 2026
                </span>

            </div>

        </div>

    </div>

</div>


<script>

    function togglePassword() {

        const passwordInput =
            document.querySelector('.password-input');

        const button =
            document.querySelector('.show-password');

        if (passwordInput.type === "password") {

            passwordInput.type = "text";

            button.textContent = "🙈";

        } else {

            passwordInput.type = "password";

            button.textContent = "👁";

        }

    }

</script>