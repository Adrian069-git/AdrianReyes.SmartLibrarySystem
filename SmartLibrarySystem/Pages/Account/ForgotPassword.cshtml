@page "/account/forgot-password"

@model ForgotPasswordModel

<div class="forgot-page">

    <!-- LEFT BRAND PANEL -->
    <div class="forgot-brand-panel">

        <!-- BRAND -->
        <div class="brand-container">

            <div class="brand-logo">
                SL
            </div>

            <div class="brand-name">
                <strong>Smart Library</strong>
                <span>Management System</span>
            </div>

        </div>


        <!-- CONTENT -->
        <div class="brand-content">

            <span class="small-label">
                ACCOUNT SECURITY
            </span>

            <h1>
                Reset your<br />
                <span>password.</span>
            </h1>

            <p>
                Don't worry if you forgot your password. Enter your
                registered email address and we'll help you get back
                into your Smart Library account.
            </p>


            <!-- SECURITY FEATURES -->
            <div class="security-list">

                <div class="security-item">

                    <div class="security-icon">
                        🔐
                    </div>

                    <div>
                        <strong>Secure Recovery</strong>
                        <span>Password reset links are sent securely.</span>
                    </div>

                </div>


                <div class="security-item">

                    <div class="security-icon">
                        ✉
                    </div>

                    <div>
                        <strong>Email Verification</strong>
                        <span>Use your registered account email.</span>
                    </div>

                </div>


                <div class="security-item">

                    <div class="security-icon">
                        ✓
                    </div>

                    <div>
                        <strong>Easy Access</strong>
                        <span>Return to your account after resetting.</span>
                    </div>

                </div>

            </div>

        </div>


        <!-- FOOTER -->
        <div class="brand-footer">

            <span>Organize.</span>
            <span>Manage.</span>
            <span>Discover.</span>

        </div>

    </div>


    <!-- RIGHT CONTENT -->
    <div class="forgot-panel">

        <div class="forgot-box">

            <!-- MOBILE BRAND -->
            <div class="mobile-brand">

                <div class="mobile-logo">
                    SL
                </div>

                <div>
                    <strong>Smart Library</strong>
                    <span>Management System</span>
                </div>

            </div>


            <!-- HEADER -->
            <div class="forgot-header">

                <span class="page-label">
                    PASSWORD RECOVERY
                </span>

                <h2>
                    Forgot password?
                </h2>

                <p>
                    Enter your email address and we'll send you
                    a password reset link.
                </p>

            </div>


            <!-- SUCCESS MESSAGE -->
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="success-message">

                    <div class="message-icon">
                        ✓
                    </div>

                    <div>
                        @Model.SuccessMessage
                    </div>

                </div>
            }


            <!-- VALIDATION SUMMARY -->
            <div asp-validation-summary="ModelOnly"
                 class="error-summary">
            </div>


            <!-- FORM -->
            <form method="post" class="forgot-form">

                <!-- EMAIL -->
                <div class="input-group-custom">

                    <label asp-for="ForgotPasswordDto.EmailAddress">
                        Email Address
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">
                            ✉
                        </span>

                        <input asp-for="ForgotPasswordDto.EmailAddress"
                               type="email"
                               class="custom-input"
                               placeholder="Enter your registered email"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="ForgotPasswordDto.EmailAddress"
                          class="validation-message">
                    </span>

                </div>


                <!-- SEND BUTTON -->
                <button type="submit" class="reset-button">

                    <span>
                        Send Reset Link
                    </span>

                    <span class="button-arrow">
                        →
                    </span>

                </button>


                <!-- INFORMATION -->
                <div class="recovery-info">

                    <div class="info-icon">
                        i
                    </div>

                    <p>
                        Make sure you enter the email address associated
                        with your Smart Library account.
                    </p>

                </div>

            </form>


            <!-- BACK TO LOGIN -->
            <div class="back-login">

                <a asp-page="/Account/Login">

                    <span class="back-arrow">
                        ←
                    </span>

                    Back to Login

                </a>

            </div>


            <!-- FOOTER -->
            <div class="forgot-footer">

                <span>
                    Smart Library Management System
                </span>

                <span>
                    © 2026
                </span>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}