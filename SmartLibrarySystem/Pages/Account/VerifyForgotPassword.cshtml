@page "/account/verify-forgot-password"
@model VerifyForgotPasswordModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="text-center mb-3">Reset Password</h2>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    @if (Model.IsTokenValid)
                    {
                        <p class="text-muted">
                            Enter your new password below.
                        </p>

                        <form method="post">
                            <input asp-for="ResetPasswordDto.Token" type="hidden" />
                            <input asp-for="ResetPasswordDto.UserId" type="hidden" />

                            <div class="mb-3">
                                <label asp-for="ResetPasswordDto.NewPassword"
                                       class="form-label">New Password</label>

                                <input asp-for="ResetPasswordDto.NewPassword"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password" />

                                <span asp-validation-for="ResetPasswordDto.NewPassword"
                                      class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ResetPasswordDto.ConfirmNewPassword"
                                       class="form-label">Confirm New Password</label>

                                <input asp-for="ResetPasswordDto.ConfirmNewPassword"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password" />

                                <span asp-validation-for="ResetPasswordDto.ConfirmNewPassword"
                                      class="text-danger"></span>
                            </div>

                            <div class="alert alert-info">
                                Password must be at least 12 characters and include
                                uppercase, lowercase, number, special character,
                                and at least 6 unique characters.
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                Reset Password
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center">
                            <a asp-page="/Account/ForgotPassword"
                               class="btn btn-primary">
                                Request a New Link
                            </a>
                        </div>
                    }

                    <div class="text-center mt-3">
                        <a asp-page="/Account/Login">Back to Login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
